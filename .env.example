# Copy to .env for local development. In production set these as environment
# variables in your platform (Coolify etc.). NEVER commit a real .env.

# ── Server ───────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated browser origins allowed to call the API (your deployed web
# app origin(s) go here too).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── Database / cache ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aida:CHANGE_ME@localhost:5432/aida_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Must match the stored vectors (unchanged: 768). HNSW supports at most 2000.
EMBEDDING_DIM=768
REDIS_URL=redis://localhost:6379/0
REDIS_HISTORY_TTL=21600

# ── Brain: Google Gemini ─────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Optional stronger/different model for developer/architect/coder personas.
GEMINI_CODER_MODEL=
# Backup model used automatically when the main one stalls, is overloaded (503) or
# out of quota (429). STRONGLY recommended: with it empty a single overloaded model
# takes the whole app down. The ID below is the one your key shows as active;
# confirm it with scripts/diag_gemini.py. It also backs up speech-to-text.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Thinking level. Valid values differ per model: gemini-3.8-flash accepts
# low | medium | high (NOT "minimal"). low = fastest. If rejected, the app drops it
# automatically and logs a warning.
GEMINI_THINKING_LEVEL=low
GEMINI_STT_THINKING_LEVEL=low
# Backup speech-to-text model; empty = reuse GEMINI_FALLBACK_MODEL above.
GEMINI_STT_FALLBACK_MODEL=
# Google recommends the default (1.0) for Gemini 3 — leave empty.
GEMINI_TEMPERATURE=
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_EMBED_MODEL=gemini-embedding-2

# Optional: LLM_PROVIDER=anthropic uses Claude for CHAT only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Voice (Gemini) ───────────────────────────────────────────────────
# Speech-to-text: dedicated transcription models (they detect Bengali and English
# on their own). The file model answers one recorded clip (fallback path); the
# "-live" model streams captions + final text while the person is still speaking.
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_STT_LIVE_MODEL=gemini-3.5-transcribe-live
# false = never use the live WebSocket; every utterance goes through the clip path.
STT_LIVE_ENABLED=true
# SMART = punctuated, clean text | VERBATIM = exactly what was said.
GEMINI_STT_MODE=SMART
# Language hints for speech recognition (BCP-47). Pure auto-detect can turn room noise into
# Chinese/Russian/... text, so the two languages we speak are hinted. Empty = automatic.
STT_LANGUAGES=bn-BD,en-US
# Safety net: a transcript written (mostly) in another script is dropped as "no speech".
# Script words from Unicode character names (bengali, latin, devanagari, arabic, cyrillic,
# cjk ...), comma separated. Empty = accept any script.
STT_ALLOWED_SCRIPTS=bengali,latin
# After the person stops: longest wait for the final text, and how long to keep
# waiting for more once a final segment has arrived (seconds). Lower = faster.
STT_LIVE_FINAL_WAIT=0.9
STT_LIVE_FINAL_SETTLE=0.3

# Text-to-speech. Audio is streamed as Google generates it (first words in ~0.3 s).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Lighter sibling used automatically if the main voice is overloaded / out of quota.
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
# No first audio byte within this many seconds -> that model has failed (fallback model).
TTS_FIRST_AUDIO_TIMEOUT=7
# ...and the fallback model is ALSO started in parallel when the main one has produced no
# audio after this many seconds; whichever answers first is played (0 = only after a failure).
TTS_HEDGE_AFTER=2.5
TTS_IDLE_TIMEOUT=10
# After Google answers a voice request with 429 (quota), that voice model is left alone for at
# least this many seconds (longer if Google asks, capped by _MAX); the browser voice speaks
# meanwhile. 0 = no gate.
# A free-tier key hits this quickly; a paid key normally never does.
TTS_QUOTA_COOLDOWN=20
TTS_QUOTA_COOLDOWN_MAX=300
# The avatar of the selected mode decides which of these is used:
# Writer = female voice; every other mode = male voice.
TTS_VOICE_FEMALE=Kore
TTS_VOICE_MALE=Charon
# Optional Bangla-specific voices (run: python scripts/list_voices.py)
TTS_VOICE_FEMALE_BN=
TTS_VOICE_MALE_BN=

# ── Memory relevance cut-off (cosine distance; tune with smoke_test.py) ──
MEMORY_MAX_DISTANCE=0.45
# The memory lookup runs in parallel with the database work; seconds (from the start of the
# request) it may take before the turn goes ahead without it.
MEMORY_RECALL_TIMEOUT=0.6

# ── Reply pacing ──
# A long first sentence is released at its first comma/semicolon/dash after this many
# characters so the voice can start on the first clause. 0 = off.
FIRST_CLAUSE_CHARS=80

# ── Abuse protection (API has no login by design) ────────────────────
RATE_LIMIT_ENABLED=true
RATE_CHAT_PER_MIN=20
RATE_STT_PER_MIN=30
RATE_TTS_PER_MIN=120
# Global per-day ceilings bounding worst-case spend. 0 = unlimited.
DAILY_CHAT_CAP=3000
DAILY_STT_CAP=3000
DAILY_TTS_CAP=30000
